// ═══════════════════════════════════════════════════════════════════════════
// CDH MAKER — firestore.rules
// Reglas de seguridad de la base de datos Firestore (colección de clientes).
// Estas reglas son la VERDADERA capa de seguridad del proyecto: se ejecutan
// en los servidores de Google y no pueden ser evadidas desde el navegador.
// Se despliegan con:  firebase deploy --only firestore:rules
// ───────────────────────────────────────────────────────────────────────────
// Autor:    Ing. Henry Taborda — CDH Maker (Medellín, Colombia)
// Contacto: cdhmaker@gmail.com
// Última actualización: 2026-07-19
// ═══════════════════════════════════════════════════════════════════════════

rules_version = '2';               // sintaxis moderna de reglas (v2)
service cloud.firestore {
  // Ámbito: todos los documentos de la base de datos del proyecto
  match /databases/{database}/documents {

    // ── Colección "clients" (registros del formulario del sitio) ──────────
    // Principio: cada usuario solo puede ver y tocar SU propio documento.
    // El administrador (Ing. Henry Taborda) lee la colección completa desde
    // la Consola de Firebase, que no pasa por estas reglas.
    match /clients/{clientId} {

      // CREAR: solo usuarios autenticados y con los campos mínimos válidos
      // (evita que un anónimo o un script inserte documentos basura)
      allow create: if request.auth != null
        && request.resource.data.email is string
        && request.resource.data.name is string;

      // LEER y ACTUALIZAR: solo el dueño del documento, identificado porque
      // el id del doc es su uid, o porque el email del doc coincide con el
      // email verificado de su token de autenticación
      allow read, update: if request.auth != null
        && (request.auth.uid == clientId
            || request.auth.token.email == resource.data.email);

      // BORRAR: nadie desde el cliente (solo el admin desde la Consola).
      // Protege el historial de clientes contra borrados accidentales o maliciosos
      allow delete: if false;
    }

    // ── Portal de firma electrónica (public/firma.js) ────────────────────
    // firmas/{exp}/eventos/{id}: exp = SHA-256(token del enlace : código),
    // así que solo quien tiene el enlace Y el código conoce la ruta. No hay
    // regla de listado global ni de collection group: nadie puede enumerar
    // expedientes. Cada evento se crea una sola vez y nunca se edita ni se
    // borra (prueba de la firma, art. 12 Ley 527 de 1999). La hora la pone el
    // servidor (request.time), no el navegador.
    match /firmas/{exp}/eventos/{id} {
      allow get, list: if exp.matches('^[0-9a-f]{64}$');
      allow update, delete: if false;
      allow create: if exp.matches('^[0-9a-f]{64}$')
        && request.resource.data.at == request.time
        && request.resource.data.ua is string
        && request.resource.data.ua.size() <= 400
        && (esLectura(id, request.resource.data)
            || esCondiciones(exp, id, request.resource.data)
            || esFirma(exp, id, request.resource.data));
    }

    // ── CRM y firma con enlaces temporales (public/crm/, public/firmar.html) ──
    // No hay secreto: crear enlaces, listar y ensamblar exige una sesión de
    // Firebase Auth con correo verificado de un administrador de CDH Maker.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['cdhmaker@gmail.com', 'henrytaborda57@gmail.com', 'isarias09@gmail.com'];
    }

    // enlaces/{token}: un documento por firmante; el id es un token aleatorio
    // de 32 bytes que solo conoce quien recibió el enlace.
    match /enlaces/{token} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if esAdmin()
        && token.matches('^[A-Za-z0-9_-]{32,64}$')
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.expira is timestamp
        && request.resource.data.expira > request.time
        && request.resource.data.expira <= request.time + duration.value(30, 'd');
      // Firmar: una sola vez, antes de vencer y tocando solo los campos de la firma.
      // Anular: solo el administrador y solo si no se ha firmado.
      allow update: if (resource.data.estado == 'pendiente'
          && request.time < resource.data.expira
          && request.resource.data.estado == 'firmado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'datos', 'firma', 'firmadoEn', 'ua', 'tz', 'hashDoc'])
          && request.resource.data.firmadoEn == request.time
          && request.resource.data.datos is map
          && request.resource.data.hashDoc is list
          && request.resource.data.firma is string
          && request.resource.data.firma.matches('^data:image/png;base64,.*')
          && request.resource.data.firma.size() < 400000)
        || (esAdmin()
          && resource.data.estado == 'pendiente'
          && request.resource.data.estado == 'anulado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'anuladoEn'])
          && request.resource.data.anuladoEn == request.time);
      allow delete: if esAdmin() && resource.data.estado != 'firmado';
    }

    // Expediente de cada cliente: solicitudes y archivos (PDF y registro.json
    // en partes de base64, porque Cloud Storage exige el plan Blaze). Solo admin.
    // Los archivos no se editan: se crean, se leen o se borran.
    match /crm_clientes/{cliente} {
      allow read, create, update: if esAdmin();
      allow delete: if false;
      match /solicitudes/{sid} {
        allow read, create, update: if esAdmin();
        allow delete: if false;
      }
      match /archivos/{aid} {
        allow read, create, delete: if esAdmin();
        // Única edición permitida: moverlo de carpeta en CRM → Docs.
        allow update: if esAdmin() && soloCarpeta();
        match /partes/{n} {
          allow read, create, delete: if esAdmin();
        }
      }
    }
    // CRM → Docs lista los archivos de todos los expedientes con una consulta de grupo.
    match /{ruta=**}/archivos/{aid} {
      allow read: if esAdmin();
    }
    // Documentos generales de CDH Maker (no pertenecen a un cliente). Mismo esquema que archivos/.
    match /crm_docs/{aid} {
      allow read, create, delete: if esAdmin();
      allow update: if esAdmin() && soloCarpeta();
      match /partes/{n} {
        allow read, create, delete: if esAdmin();
      }
    }
    match /crm_plantillas/{pid} {
      allow read, write: if esAdmin();
    }
    // Cotizador (CRM → Cotizador): cotizaciones, facturas y cuentas de cobro. No se borran: se anulan.
    // Una vez numerada, el número no cambia (la factura lo recibe al emitirse).
    match /crm_documentos/{did} {
      allow read: if esAdmin();
      allow create: if esAdmin() && documentoValido();
      allow update: if esAdmin() && documentoValido()
        && (!('numero' in resource.data) || resource.data.numero == '' || request.resource.data.numero == resource.data.numero);
      allow delete: if false;
    }
    match /crm_consecutivos/{cid} {
      allow read, create, update: if esAdmin() && cid.matches('^[a-z_]+-[0-9]{4}$');
      allow delete: if false;
    }
    match /crm_catalogo/{iid} {
      allow read, write: if esAdmin();
    }
    match /crm_config/{cid} {
      allow read, write: if esAdmin();
    }
    // Libro contable de CDH Maker (CRM → Libro contable). Solo administradores. Los movimientos
    // no se borran: se anulan (estado 'anulado'), para conservar la trazabilidad.
    match /crm_libro/{mid} {
      allow read: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.valor is number && request.resource.data.valor > 0
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.estado in ['vigente', 'anulado'];
      allow delete: if false;
    }

    function soloCarpeta() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carpeta'])
        && request.resource.data.carpeta is string;
    }

    function documentoValido() {
      return request.resource.data.tipo in ['cotizacion', 'factura']
        && request.resource.data.estado in ['borrador', 'enviada', 'aceptada', 'rechazada', 'facturada', 'emitida', 'pagada', 'anulada']
        && request.resource.data.items is list
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function evento(exp, id) {
      return /databases/$(database)/documents/firmas/$(exp)/eventos/$(id);
    }

    function huella(h) {
      return h is string && h.matches('^[0-9a-f]{64}$');
    }

    function persona(d) {
      return d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 120
        && d.cedula is string && d.cedula.matches('^[0-9]{5,12}$')
        && d.cargo is string && d.cargo.size() <= 80;
    }

    // lectura-<doc>: el firmante recorrió el documento hasta el final
    function esLectura(id, d) {
      return id.matches('^lectura-[a-z]{2,20}$')
        && d.keys().hasOnly(['tipo', 'doc', 'sha256', 'ua', 'at'])
        && d.tipo == 'lectura'
        && id == 'lectura-' + d.doc
        && huella(d.sha256);
    }

    // condiciones: acepta contrato, acuerdo de firma y aviso de privacidad,
    // solo si ya leyó los tres (mismos ids que REQUERIDOS en firma.js)
    function esCondiciones(exp, id, d) {
      return id == 'condiciones'
        && d.keys().hasOnly(['tipo', 'docs', 'nombre', 'cedula', 'cargo', 'referencia', 'ua', 'at'])
        && d.tipo == 'condiciones'
        && d.docs is map && d.docs.size() <= 10
        && d.docs.keys().hasAll(['contrato', 'firmaelec', 'privacidad'])
        && huella(d.docs.contrato) && huella(d.docs.firmaelec) && huella(d.docs.privacidad)
        && persona(d)
        && d.referencia is bool
        && exists(evento(exp, 'lectura-contrato'))
        && exists(evento(exp, 'lectura-firmaelec'))
        && exists(evento(exp, 'lectura-privacidad'));
    }

    // firma-<doc>: exige condiciones aceptadas y el documento leído, y que
    // firme la misma persona que aceptó las condiciones
    function esFirma(exp, id, d) {
      return id.matches('^firma-[a-z]{2,20}$')
        && d.keys().hasOnly(['tipo', 'doc', 'sha256', 'nombre', 'cedula', 'cargo', 'trazo', 'declaracion', 'ua', 'at'])
        && d.tipo == 'firma'
        && id == 'firma-' + d.doc
        && huella(d.sha256)
        && persona(d)
        && d.declaracion == true
        && d.trazo is string && d.trazo.size() < 150000
        && d.trazo.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && exists(evento(exp, 'lectura-' + d.doc))
        && get(evento(exp, 'condiciones')).data.cedula == d.cedula
        && get(evento(exp, 'condiciones')).data.nombre == d.nombre;
    }
  }
}
